{
 "_doc": "Login screen states. `olaz --ui-render S02-login-<step>` builds the LoginState of each `phase` entry (no zstate needed).",
 "name": "login",
 "phases": [
  {"capture": "S02-login-generating", "login": {"step": "generating"}},
  {"capture": "S02-login-qr", "login": {"step": "waitingScan", "qr": "fixture:media/qr-sample.png"}},
  {"capture": "S02-login-qr2", "login": {"step": "waitingScan", "qr": "fixture:media/qr-sample.png", "isSecondQR": true}},
  {"capture": "S02-login-confirm", "login": {"step": "waitingConfirm", "name": "Minh Anh", "avatar": "fixture:avatars/minh-anh.png"}},
  {"capture": "S02-login-expired", "login": {"step": "expired", "qr": "fixture:media/qr-sample.png"}},
  {"capture": "S02-login-failed", "login": {"step": "failed", "message": "Vui lòng thử lại QR mới."}}
 ]
}
